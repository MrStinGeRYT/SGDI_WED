{
  "oficio": {
    "layout": "oficio",
    "description": "Comunicación formal institucional externa o interna",
    "fields": [
      { "id": "numero_oficio",      "label": "Número de oficio",       "type": "text",     "required": true,  "placeholder": "FCI-DAC-2026-001",                        "hint": "Folio o número de control" },
      { "id": "lugar_fecha",        "label": "Fecha",                  "type": "date",     "required": true,  "placeholder": "",                                         "hint": "Fecha de emisión" },
      { "id": "area_emisora",       "label": "Área emisora",           "type": "text",     "required": true,  "placeholder": "Coordinación de Posgrado e Investigación",  "hint": "Unidad institucional que emite" },
      { "id": "destinatario",       "label": "Destinatario",           "type": "text",     "required": true,  "placeholder": "Dr. Juan Pérez García",                    "hint": "" },
      { "id": "cargo_destinatario", "label": "Cargo del destinatario", "type": "text",     "required": true,  "placeholder": "Director de Posgrado",                     "hint": "" },
      { "id": "asunto",             "label": "Asunto",                 "type": "text",     "required": true,  "placeholder": "Designación de miembro de jurado",          "hint": "" },
      { "id": "cuerpo",             "label": "Cuerpo del documento",   "type": "textarea", "required": true,  "placeholder": "Por medio del presente...",                 "hint": "Redacta el contenido del oficio" },
      { "id": "firmante",           "label": "Nombre del firmante",    "type": "text",     "required": true,  "placeholder": "Dra. María González",                      "hint": "" },
      { "id": "cargo_firmante",     "label": "Cargo del firmante",     "type": "text",     "required": true,  "placeholder": "Coordinadora Académica",                   "hint": "" },
      { "id": "copia",              "label": "c.c.p.",                 "type": "text",      "required": false, "placeholder": "Archivo, Interesado",                      "hint": "Separar con comas" },
      { "id": "anexos",             "label": "Anexos",                 "type": "text",      "required": false, "placeholder": "Ninguno",                                  "hint": "" },
      { "id": "firma_texto",       "label": "Firma (texto)",          "type": "text",      "required": false, "placeholder": "Escribe o pega tu firma aquí",              "hint": "Se muestra si no hay imagen de firma" },
      { "id": "firma_imagen",       "label": "Firma (imagen)",          "type": "signature", "required": false, "placeholder": "",                                         "hint": "PNG o JPG, máx. 1 MB. Tiene prioridad sobre la firma en texto." }
    ]
  },
  "constancia": {
    "layout": "constancia",
    "description": "Documento que acredita un hecho o situación sobre una persona",
    "fields": [
      { "id": "area_emisora",       "label": "Área emisora",           "type": "text",     "required": true,  "placeholder": "Coordinación de Posgrado e Investigación",  "hint": "Unidad institucional que expide" },
      { "id": "fecha",              "label": "Fecha de expedición",    "type": "date",     "required": true,  "placeholder": "",                                         "hint": "" },
      { "id": "firmante",           "label": "Nombre del firmante",    "type": "text",     "required": true,  "placeholder": "Dra. María González",                      "hint": "Quien expide la constancia" },
      { "id": "cargo_firmante",     "label": "Cargo del firmante",     "type": "text",     "required": true,  "placeholder": "Coordinadora Académica",                   "hint": "" },
      { "id": "beneficiario",       "label": "Beneficiario",           "type": "text",     "required": true,  "placeholder": "Ing. Pedro García Morales",                "hint": "Persona a quien se expide la constancia" },
      { "id": "cargo_beneficiario", "label": "Cargo del beneficiario", "type": "text",     "required": false, "placeholder": "Alumno de Posgrado",                       "hint": "Opcional" },
      { "id": "tipo_constancia",    "label": "Tipo de constancia",     "type": "text",     "required": true,  "placeholder": "ha participado activamente en el Comité de Ética", "hint": "Completar: 'Que [beneficiario] ...' " },
      { "id": "periodo",            "label": "Periodo",                "type": "text",     "required": false, "placeholder": "del 1 de enero al 31 de diciembre de 2025", "hint": "Dejar vacío si no aplica" },
      { "id": "descripcion",        "label": "Descripción adicional",  "type": "textarea", "required": false, "placeholder": "Información adicional que se desea incluir en la constancia...", "hint": "Opcional" }
    ]
  },
  "memorandum": {
    "layout": "memorandum",
    "description": "Comunicación interna breve entre áreas o personas",
    "fields": [
      { "id": "area_emisora",  "label": "Área emisora",      "type": "text",     "required": true,  "placeholder": "Coordinación de Posgrado e Investigación", "hint": "Departamento que emite" },
      { "id": "fecha",         "label": "Fecha",             "type": "date",     "required": true,  "placeholder": "",                                        "hint": "" },
      { "id": "para",          "label": "Para",              "type": "text",     "required": true,  "placeholder": "Dr. Alejandro Martínez",                   "hint": "Destinatario interno" },
      { "id": "cargo_para",    "label": "Cargo del destinatario","type": "text", "required": true,  "placeholder": "Director de la Facultad",                  "hint": "" },
      { "id": "de",            "label": "De",                "type": "text",     "required": true,  "placeholder": "Dra. María González",                     "hint": "Remitente" },
      { "id": "cargo_de",      "label": "Cargo del remitente","type": "text",    "required": true,  "placeholder": "Coordinadora Académica",                   "hint": "" },
      { "id": "asunto",        "label": "Asunto",            "type": "text",     "required": true,  "placeholder": "Solicitud de autorización para evento",    "hint": "" },
      { "id": "cuerpo",        "label": "Cuerpo",            "type": "textarea",  "required": true,  "placeholder": "Por medio del presente, me permito comunicar...", "hint": "" },
      { "id": "prioridad",     "label": "Prioridad",         "type": "text",      "required": false, "placeholder": "Normal",                                   "hint": "Normal / Urgente / Informativo" },
      { "id": "firma_texto",  "label": "Firma (texto)",     "type": "text",      "required": false, "placeholder": "Escribe o pega tu firma aquí",              "hint": "Se muestra si no hay imagen de firma" },
      { "id": "firma_imagen",  "label": "Firma (imagen)",     "type": "signature", "required": false, "placeholder": "",                                         "hint": "PNG o JPG, máx. 1 MB. Tiene prioridad sobre la firma en texto." }
    ]
  },
  "acta": {
    "layout": "acta",
    "description": "Registro oficial de una reunión o sesión institucional",
    "fields": [
      { "id": "numero_acta",      "label": "Número de acta",       "type": "text",     "required": true,  "placeholder": "ACT-FCI-2026-003",               "hint": "Folio del acta" },
      { "id": "tipo_reunion",     "label": "Tipo de reunión",      "type": "text",     "required": true,  "placeholder": "Sesión Ordinaria de Consejo",     "hint": "Ej: Reunión de Seguimiento, Sesión Ordinaria" },
      { "id": "area_emisora",     "label": "Área emisora",         "type": "text",     "required": true,  "placeholder": "Secretaría Académica",            "hint": "" },
      { "id": "fecha",            "label": "Fecha",                "type": "date",     "required": true,  "placeholder": "",                               "hint": "" },
      { "id": "hora",             "label": "Hora",                 "type": "text",     "required": false, "placeholder": "10:00 hrs",                      "hint": "" },
      { "id": "lugar",            "label": "Lugar",                "type": "text",     "required": true,  "placeholder": "Sala de Juntas, Edificio B",      "hint": "" },
      { "id": "asistentes",       "label": "Asistentes",           "type": "textarea", "required": true,  "placeholder": "1. Dr. Alejandro Martínez\n2. Dra. María González\n3. Lic. Roberto Torres", "hint": "Un asistente por línea" },
      { "id": "orden_del_dia",    "label": "Orden del día",        "type": "textarea", "required": true,  "placeholder": "1. Lista de asistencia\n2. Lectura del acta anterior\n3. ...", "hint": "" },
      { "id": "acuerdos",         "label": "Acuerdos",             "type": "textarea", "required": true,  "placeholder": "Acuerdo 1: ...\nAcuerdo 2: ...", "hint": "Registra los acuerdos tomados" },
      { "id": "responsable",      "label": "Responsable / Preside","type": "text",     "required": true,  "placeholder": "Dra. María González",             "hint": "Quien preside o firma el acta" },
      { "id": "cargo_responsable","label": "Cargo del responsable","type": "text",     "required": true,  "placeholder": "Coordinadora Académica",          "hint": "" },
      { "id": "proxima_reunion",  "label": "Próxima reunión",      "type": "text",     "required": false, "placeholder": "30 de mayo de 2026",              "hint": "Dejar vacío si no aplica" }
    ]
  },
  "informe": {
    "layout": "informe",
    "description": "Reporte formal de actividades, resultados o avances",
    "fields": [
      { "id": "titulo",           "label": "Título del informe",   "type": "text",     "required": true,  "placeholder": "Informe de Actividades Académicas", "hint": "" },
      { "id": "area_emisora",     "label": "Área emisora",         "type": "text",     "required": true,  "placeholder": "División de Posgrado e Investigación", "hint": "" },
      { "id": "periodo",          "label": "Periodo",              "type": "text",     "required": true,  "placeholder": "Enero – Junio 2026",               "hint": "" },
      { "id": "responsable",      "label": "Responsable",          "type": "text",     "required": true,  "placeholder": "Dra. María González",              "hint": "" },
      { "id": "cargo_responsable","label": "Cargo",                "type": "text",     "required": true,  "placeholder": "Coordinadora Académica",           "hint": "" },
      { "id": "introduccion",     "label": "I. Introducción",      "type": "textarea", "required": true,  "placeholder": "El presente informe tiene como objetivo...", "hint": "" },
      { "id": "desarrollo",       "label": "II. Desarrollo",       "type": "textarea", "required": true,  "placeholder": "Durante el periodo reportado se llevaron a cabo...", "hint": "Actividades, resultados, indicadores" },
      { "id": "conclusiones",     "label": "III. Conclusiones",    "type": "textarea",  "required": true,  "placeholder": "Con base en las actividades realizadas...", "hint": "" },
      { "id": "recomendaciones",  "label": "IV. Recomendaciones",  "type": "textarea",  "required": false, "placeholder": "Se recomienda...",                 "hint": "Opcional" },
      { "id": "firma_texto",     "label": "Firma (texto)",        "type": "text",      "required": false, "placeholder": "Escribe o pega tu firma aquí",              "hint": "Se muestra si no hay imagen de firma" },
      { "id": "firma_imagen",     "label": "Firma (imagen)",        "type": "signature", "required": false, "placeholder": "",                                  "hint": "PNG o JPG, máx. 1 MB. Tiene prioridad sobre la firma en texto." }
    ]
  }
}
